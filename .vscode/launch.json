{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            }
        },
        {
            "name": "Qwen3-IOS: Train Model",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/Qwen3-IOS/training/train_01_frozen_llm_joint_encoder_projector.py",
            "console": "integratedTerminal",
            "justMyCode": true,
            "cwd": "${workspaceFolder}/src/Qwen3-IOS/training",
            "args": [
                "--config",
                "${workspaceFolder}/src/Qwen3-IOS/configs/training_setups/02_classification_pretrain_then_projector/02_pointqwen_projector_after_classification.yaml",
                "--use_wandb",
                "--run_name",
                "qwen3_pt_test"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_VISIBLE_DEVICES": "0"
            }
        },
        {
            "name": "Qwen3-IOS: Intraoral-Photos Train Model",
            "type": "debugpy",
            "request": "launch",
            "python": "/homes/llumetti/llumetti_venvs/iosqwen/bin/python",
            "program": "${workspaceFolder}/src/Qwen3-IOS/training/train_intraoralphotos.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}/src/Qwen3-IOS/training",
            "args": [
                "--config",
                "${workspaceFolder}/src/Qwen3-IOS/configs/auxiliary_training/qwen3vl_intraoral_photo_finetune.yaml",
                "--train_vision",
                "--run_name",
                "qwen3_intraoralphotos_debug"
            ],
            "env": {
                "PYTHONPATH": "${workspaceFolder}",
                "CUDA_VISIBLE_DEVICES": "0",
                "TOKENIZERS_PARALLELISM": "false"
            }
        }
    ]
}
